#!/usr/bin/env bash
# Honey CLI

set -Eeuo pipefail

VERSION="0.5.1"

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" == /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PROFILE_SOURCE="$ROOT_DIR/config/fontconfig/99-honey.conf"
FONTCONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d"
PROFILE_TARGET="$FONTCONFIG_DIR/99-honey.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/honey"
BACKUP_DIR="$STATE_DIR/backups"
ORIGINAL_DIR="$STATE_DIR/originals"
MARKER="Managed by Honey"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
ENVIRONMENT_DIR="$CONFIG_HOME/environment.d"
PLASMA_ENV_DIR="$CONFIG_HOME/plasma-workspace/env"
HONEY_ENVIRONMENT_TARGET="$ENVIRONMENT_DIR/90-honey.conf"
HONEY_PLASMA_ENV_TARGET="$PLASMA_ENV_DIR/90-honey.sh"
HONEY_ACTIVE_VALUE="1"
HONEY_HINTSTYLE="hintmedium"
HONEY_KDE_FONT_WEIGHT="500"
HONEY_FREETYPE_PROPERTIES="truetype:interpreter-version=40"
GTK3_SETTINGS="$CONFIG_HOME/gtk-3.0/settings.ini"
GTK4_SETTINGS="$CONFIG_HOME/gtk-4.0/settings.ini"
XSETTINGSD_CONFIG="$CONFIG_HOME/xsettingsd/xsettingsd.conf"
KDE_GLOBALS="$CONFIG_HOME/kdeglobals"
FIREFOX_CONFIG_DIR="$HOME/.mozilla/firefox"
FIREFOX_PROFILES_INI="$FIREFOX_CONFIG_DIR/profiles.ini"
FIREFOX_CHROME_CSS_SOURCE="$ROOT_DIR/config/firefox/userChrome.css"
FIREFOX_WEB_CSS_SOURCE="$ROOT_DIR/config/firefox/userContent.css"

ELECTRON_FLAGS="$CONFIG_HOME/electron-flags.conf"
CODIUM_FLAGS="$CONFIG_HOME/codium-flags.conf"
CODE_FLAGS="$CONFIG_HOME/code-flags.conf"
VSCODE_OSS_FLAGS="$CONFIG_HOME/vscode-oss-flags.conf"

LOCAL_APPLICATIONS_DIR="$DATA_HOME/applications"
CODIUM_DESKTOP_SOURCE="/usr/share/applications/codium.desktop"
CODIUM_URL_DESKTOP_SOURCE="/usr/share/applications/codium-url-handler.desktop"
CODIUM_DESKTOP_TARGET="$LOCAL_APPLICATIONS_DIR/codium.desktop"
CODIUM_URL_DESKTOP_TARGET="$LOCAL_APPLICATIONS_DIR/codium-url-handler.desktop"
CODIUM_HONEY_DESKTOP_TARGET="$LOCAL_APPLICATIONS_DIR/codium-honey.desktop"
CODIUM_HONEY_USER_DATA_DIR="$CONFIG_HOME/VSCodium-Honey"
CODIUM_HONEY_EXTENSIONS_DIR="$DATA_HOME/honey/codium/extensions"
CODIUM_WRAPPER="/usr/bin/codium"
HONEY_ELECTRON_FLAGS=(--disable-lcd-text --font-render-hinting=medium)

green='\033[0;32m'
yellow='\033[1;33m'
red='\033[0;31m'
reset='\033[0m'

ok() { printf '%bOK%b %s\n' "$green" "$reset" "$1"; }
warn() { printf '%bWARN%b %s\n' "$yellow" "$reset" "$1"; }
die() { printf '%bERROR%b %s\n' "$red" "$reset" "$1" >&2; exit 1; }

usage() {
    cat <<'EOF'
Honey

Uso:
  honey apply        Activa fontconfig y compatibilidad GTK/KDE/Electron
  honey reset        Retira Honey y restaura configs originales conocidas
  honey launch-codium [RUTA] Abre Codium con los flags de Honey
  honey launch-honey-codium [RUTA] Abre una instancia aislada para diagnostico
  honey status       Muestra estado y muestras de fontconfig
  honey doctor       Revisa dependencias y rutas
  honey paths        Muestra rutas usadas
  honey version      Muestra la version
  honey help         Muestra esta ayuda

Honey no necesita sudo. Sus cambios viven en:
  ~/.config/fontconfig/conf.d/99-honey.conf

Tambien sincroniza, con respaldo, estas capas cuando existen:
  GTK 3/4, xsettingsd, KDE/kdeglobals y entorno de sesion KDE/DBus.
  Firefox recibe una hoja userChrome.css solo para su interfaz.
EOF
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

print_paths() {
    printf 'ROOT_DIR=%s\n' "$ROOT_DIR"
    printf 'PROFILE_SOURCE=%s\n' "$PROFILE_SOURCE"
    printf 'PROFILE_TARGET=%s\n' "$PROFILE_TARGET"
    printf 'STATE_DIR=%s\n' "$STATE_DIR"
    printf 'BACKUP_DIR=%s\n' "$BACKUP_DIR"
    printf 'ORIGINAL_DIR=%s\n' "$ORIGINAL_DIR"
    printf 'HONEY_ENVIRONMENT_TARGET=%s\n' "$HONEY_ENVIRONMENT_TARGET"
    printf 'HONEY_PLASMA_ENV_TARGET=%s\n' "$HONEY_PLASMA_ENV_TARGET"
    printf 'GTK3_SETTINGS=%s\n' "$GTK3_SETTINGS"
    printf 'GTK4_SETTINGS=%s\n' "$GTK4_SETTINGS"
    printf 'XSETTINGSD_CONFIG=%s\n' "$XSETTINGSD_CONFIG"
    printf 'KDE_GLOBALS=%s\n' "$KDE_GLOBALS"
    printf 'FIREFOX_CONFIG_DIR=%s\n' "$FIREFOX_CONFIG_DIR"
    printf 'FIREFOX_PROFILES_INI=%s\n' "$FIREFOX_PROFILES_INI"
    printf 'FIREFOX_CHROME_CSS_SOURCE=%s\n' "$FIREFOX_CHROME_CSS_SOURCE"
    printf 'FIREFOX_WEB_CSS_SOURCE=%s\n' "$FIREFOX_WEB_CSS_SOURCE"
    printf 'CODIUM_FLAGS=%s\n' "$CODIUM_FLAGS"
    printf 'CODIUM_DESKTOP_TARGET=%s\n' "$CODIUM_DESKTOP_TARGET"
    printf 'CODIUM_HONEY_DESKTOP_TARGET=%s\n' "$CODIUM_HONEY_DESKTOP_TARGET"
    printf 'CODIUM_HONEY_USER_DATA_DIR=%s\n' "$CODIUM_HONEY_USER_DATA_DIR"
}

is_managed_profile() {
    [[ -f "$PROFILE_TARGET" ]] && grep -q "$MARKER" "$PROFILE_TARGET"
}

backup_existing_profile() {
    [[ -f "$PROFILE_TARGET" ]] || return 0
    is_managed_profile && return 0

    mkdir -p "$BACKUP_DIR"
    local stamp backup_path
    stamp="$(date +%Y%m%d_%H%M%S)"
    backup_path="$BACKUP_DIR/99-honey.conf.$stamp.bak"
    cp -f "$PROFILE_TARGET" "$backup_path"
    warn "Ya existia un perfil con ese nombre. Respaldo creado en $backup_path"
}

remember_original() {
    local file="$1" label="$2"
    local original_file="$ORIGINAL_DIR/$label"
    local missing_file="$ORIGINAL_DIR/$label.missing"

    mkdir -p "$ORIGINAL_DIR"

    if [[ -f "$original_file" || -f "$missing_file" ]]; then
        return 0
    fi

    if [[ -e "$file" ]]; then
        cp -f "$file" "$original_file"
    else
        : > "$missing_file"
    fi
}

restore_original() {
    local file="$1" label="$2"
    local original_file="$ORIGINAL_DIR/$label"
    local missing_file="$ORIGINAL_DIR/$label.missing"

    if [[ -f "$original_file" ]]; then
        mkdir -p "$(dirname "$file")"
        cp -f "$original_file" "$file"
        ok "Restaurado $file"
    elif [[ -f "$missing_file" ]]; then
        rm -f "$file"
        ok "Retirado $file"
    fi
}

refresh_cache() {
    if command_exists fc-cache; then
        fc-cache -f >/dev/null 2>&1 || warn "No se pudo regenerar la cache de fuentes"
    else
        warn "fc-cache no esta disponible; reinicia tus aplicaciones despues de aplicar cambios"
    fi
}

write_session_environment() {
    mkdir -p "$ENVIRONMENT_DIR" "$PLASMA_ENV_DIR"
    remember_original "$HONEY_ENVIRONMENT_TARGET" "90-honey.conf"
    remember_original "$HONEY_PLASMA_ENV_TARGET" "90-honey.sh"

    cat > "$HONEY_ENVIRONMENT_TARGET" <<EOF
# Managed by Honey
HONEY_ACTIVE=$HONEY_ACTIVE_VALUE
HONEY_FONTCONFIG=$PROFILE_TARGET
FREETYPE_PROPERTIES=$HONEY_FREETYPE_PROPERTIES
EOF

    cat > "$HONEY_PLASMA_ENV_TARGET" <<EOF
#!/usr/bin/env sh
# Managed by Honey
export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
export HONEY_FONTCONFIG="$PROFILE_TARGET"
export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
fi
EOF

    chmod +x "$HONEY_PLASMA_ENV_TARGET"
}

apply_running_session_environment() {
    export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
    export HONEY_FONTCONFIG="$PROFILE_TARGET"
    export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"

    if command_exists systemctl; then
        systemctl --user import-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || \
            warn "No pude importar el entorno Honey a systemd user en esta sesion"
    fi

    if command_exists dbus-update-activation-environment; then
        dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || \
            warn "No pude importar el entorno Honey a DBus en esta sesion"
    fi
}

reset_running_session_environment() {
    unset HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES

    if command_exists systemctl; then
        systemctl --user unset-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
    fi

    if command_exists dbus-update-activation-environment; then
        dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
    fi
}

apply_kde_session_environment() {
    write_session_environment
    apply_running_session_environment
}

set_ini_value() {
    local file="$1" section="$2" key="$3" value="$4"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || printf '[%s]\n' "$section" > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-ini.XXXXXX")"
    awk -v section="$section" -v key="$key" -v value="$value" '
        BEGIN {
            in_section = 0
            seen_section = 0
            key_written = 0
        }
        function write_key_if_needed() {
            if (seen_section && !key_written) {
                print key "=" value
                key_written = 1
            }
        }
        /^\[[^]]+\][[:space:]]*$/ {
            if (in_section) {
                write_key_if_needed()
            }
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            if (in_section) {
                seen_section = 1
            }
            print
            next
        }
        {
            if (in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=") {
                print key "=" value
                key_written = 1
                next
            }
            print
        }
        END {
            if (!seen_section) {
                print ""
                print "[" section "]"
                print key "=" value
            } else if (in_section) {
                write_key_if_needed()
            }
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

remove_ini_value_if_equals() {
    local file="$1" section="$2" key="$3" expected="$4"
    local tmp

    [[ -f "$file" ]] || return 0
    tmp="$(mktemp "$STATE_DIR/honey-ini-remove.XXXXXX")"
    awk -F= -v section="$section" -v key="$key" -v expected="$expected" '
        BEGIN {
            in_section = 0
        }
        /^\[[^]]+\][[:space:]]*$/ {
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            print
            next
        }
        {
            if (in_section && $1 == key && $2 == expected) {
                next
            }
            print
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

set_xsettings_value() {
    local file="$1" key="$2" value="$3"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || : > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-xsettings.XXXXXX")"
    awk -v key="$key" -v value="$value" '
        BEGIN { written = 0 }
        $1 == key {
            print key " " value
            written = 1
            next
        }
        { print }
        END {
            if (!written) {
                print key " " value
            }
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

ensure_flag() {
    local file="$1" pattern="$2" line="$3"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || : > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-flags.XXXXXX")"
    awk -v pattern="$pattern" '$0 !~ pattern { print }' "$file" > "$tmp"
    printf '%s\n' "$line" >> "$tmp"
    mv -f "$tmp" "$file"
}

apply_gtk_config() {
    local file label

    for file in "$GTK3_SETTINGS" "$GTK4_SETTINGS"; do
        if [[ "$file" == "$GTK3_SETTINGS" ]]; then
            label="gtk3-settings.ini"
        else
            label="gtk4-settings.ini"
        fi

        remember_original "$file" "$label"
        set_ini_value "$file" "Settings" "gtk-xft-antialias" "1"
        set_ini_value "$file" "Settings" "gtk-xft-hinting" "1"
        set_ini_value "$file" "Settings" "gtk-xft-hintstyle" "$HONEY_HINTSTYLE"
        set_ini_value "$file" "Settings" "gtk-xft-rgba" "none"
        if [[ -f "$ORIGINAL_DIR/$label.missing" ]]; then
            remove_ini_value_if_equals "$file" "Settings" "gtk-font-name" "Inter Medium 10.5"
        fi
    done
}

firefox_profile_dirs() {
    if [[ -f "$FIREFOX_PROFILES_INI" ]]; then
        awk -F= -v root="$FIREFOX_CONFIG_DIR" '
            function emit() {
                if (path == "") {
                    return
                }
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", path)
                if (relative == "1") {
                    print root "/" path
                } else {
                    print path
                }
            }
            /^\[Profile[0-9]+\][[:space:]]*$/ {
                if (in_profile) {
                    emit()
                }
                path = ""
                relative = "1"
                in_profile = 1
                next
            }
            /^\[/ {
                if (in_profile) {
                    emit()
                }
                path = ""
                in_profile = 0
                next
            }
            in_profile && $1 == "Path" {
                path = $2
                next
            }
            in_profile && $1 == "IsRelative" {
                relative = $2
                next
            }
            END {
                if (in_profile) {
                    emit()
                }
            }
        ' "$FIREFOX_PROFILES_INI"
    elif [[ -d "$FIREFOX_CONFIG_DIR" ]]; then
        find "$FIREFOX_CONFIG_DIR" -mindepth 2 -maxdepth 2 -type f -name prefs.js -printf '%h\n'
    fi | while IFS= read -r profile; do
        [[ -f "$profile/prefs.js" ]] && printf '%s\n' "$profile"
    done | sort -u
}

firefox_profile_label() {
    local profile="$1"
    local digest

    if command_exists sha256sum; then
        digest="$(printf '%s' "$profile" | sha256sum | awk '{ print substr($1, 1, 16) }')"
    else
        digest="$(printf '%s' "$profile" | cksum | awk '{ print $1 }')"
    fi
    printf 'firefox-%s' "$digest"
}

write_firefox_user_chrome() {
    local profile="$1" label="$2" file="$1/chrome/userChrome.css"
    local original_file="$ORIGINAL_DIR/$label-userChrome.css"

    mkdir -p "$profile/chrome"
    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    printf '\n' >> "$file"
    cat "$FIREFOX_CHROME_CSS_SOURCE" >> "$file"
}

write_firefox_user_content() {
    local profile="$1" label="$2" file="$1/chrome/userContent.css"
    local original_file="$ORIGINAL_DIR/$label-userContent.css"

    mkdir -p "$profile/chrome"
    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    printf '\n' >> "$file"
    cat "$FIREFOX_WEB_CSS_SOURCE" >> "$file"
}

write_firefox_user_js() {
    local profile="$1" label="$2" file="$profile/user.js"
    local original_file="$ORIGINAL_DIR/$label-user.js"

    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    cat >> "$file" <<'EOF'

// Managed by Honey: enable browser-chrome userChrome.css.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
EOF
}

apply_firefox_chrome_config() {
    local profile label
    local found=0

    [[ -f "$FIREFOX_CHROME_CSS_SOURCE" && -f "$FIREFOX_WEB_CSS_SOURCE" ]] || return 0
    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        label="$(firefox_profile_label "$profile")"
        remember_original "$profile/chrome/userContent.css" "$label-userContent.css"
        remember_original "$profile/chrome/userChrome.css" "$label-userChrome.css"
        remember_original "$profile/user.js" "$label-user.js"
        write_firefox_user_content "$profile" "$label"
        write_firefox_user_chrome "$profile" "$label"
        write_firefox_user_js "$profile" "$label"
    done < <(firefox_profile_dirs)

    if (( found )); then
        ok "Render de interfaz y trazo web neutral aplicado en sus perfiles Firefox"
    else
        warn "No encontre perfiles de Firefox; se omitio el render de interfaz"
    fi
}

reset_firefox_chrome_config() {
    local profile label

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        label="$(firefox_profile_label "$profile")"
        restore_original "$profile/chrome/userContent.css" "$label-userContent.css"
        restore_original "$profile/chrome/userChrome.css" "$label-userChrome.css"
        restore_original "$profile/user.js" "$label-user.js"
    done < <(firefox_profile_dirs)
}

firefox_chrome_state() {
    local profile file
    local found=0 active=0

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        file="$profile/chrome/userChrome.css"
        if [[ -f "$file" ]] && grep -q 'Managed by Honey: Firefox chrome only' "$file"; then
            active=$((active + 1))
        fi
    done < <(firefox_profile_dirs)

    if (( found == 0 )); then
        printf 'sin perfiles'
    else
        printf '%s/%s perfiles activos' "$active" "$found"
    fi
}

firefox_web_state() {
    local profile file
    local found=0 active=0

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        file="$profile/chrome/userContent.css"
        if [[ -f "$file" ]] && grep -q 'Managed by Honey: neutral web rendering only' "$file"; then
            active=$((active + 1))
        fi
    done < <(firefox_profile_dirs)

    if (( found == 0 )); then
        printf 'sin perfiles'
    else
        printf '%s/%s perfiles activos' "$active" "$found"
    fi
}

apply_xsettingsd_config() {
    remember_original "$XSETTINGSD_CONFIG" "xsettingsd.conf"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/Antialias" "1"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/Hinting" "1"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/HintStyle" "\"$HONEY_HINTSTYLE\""
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/RGBA" "\"none\""
}

apply_kde_config() {
    local key current promoted

    remember_original "$KDE_GLOBALS" "kdeglobals"
    set_ini_value "$KDE_GLOBALS" "General" "XftAntialias" "true"
    set_ini_value "$KDE_GLOBALS" "General" "XftHintStyle" "$HONEY_HINTSTYLE"
    set_ini_value "$KDE_GLOBALS" "General" "XftSubPixel" "none"

    for key in fixed font smallestReadableFont toolBarFont; do
        current="$(print_ini_value "$KDE_GLOBALS" "General" "$key")"
        [[ "$current" == "unset" ]] && continue
        promoted="$(printf '%s\n' "$current" | awk -F, -v weight="$HONEY_KDE_FONT_WEIGHT" 'BEGIN { OFS="," } NF >= 5 { if (($5 + 0) < (weight + 0)) $5 = weight } { print }')"
        set_ini_value "$KDE_GLOBALS" "General" "$key" "$promoted"
    done
}

should_apply_flags_file() {
    local file="$1"

    if [[ -e "$file" ]]; then
        return 0
    fi

    case "$file" in
        "$CODIUM_FLAGS")
            [[ -d "$CONFIG_HOME/VSCodium" ]] || command_exists codium
            ;;
        "$CODE_FLAGS")
            [[ -d "$CONFIG_HOME/Code" ]] || command_exists code
            ;;
        "$VSCODE_OSS_FLAGS")
            [[ -d "$CONFIG_HOME/Code - OSS" ]] || command_exists code-oss
            ;;
        *)
            return 1
            ;;
    esac
}

apply_electron_flags() {
    local file label

    for file in "$CODIUM_FLAGS" "$CODE_FLAGS" "$VSCODE_OSS_FLAGS" "$ELECTRON_FLAGS"; do
        should_apply_flags_file "$file" || continue
        label="$(basename "$file")"
        remember_original "$file" "$label"
        ensure_flag "$file" "^--font-render-hinting=" "--font-render-hinting=medium"
        ensure_flag "$file" "^--disable-lcd-text$" "--disable-lcd-text"
    done
}

patch_codium_desktop_file() {
    local source="$1" target="$2" label="$3"
    local tmp honey_cli

    [[ -f "$source" ]] || return 0

    mkdir -p "$LOCAL_APPLICATIONS_DIR" "$STATE_DIR"
    remember_original "$target" "$label"
    tmp="$(mktemp "$STATE_DIR/honey-desktop.XXXXXX")"
    honey_cli="$ROOT_DIR/bin/honey"

    awk -v honey_cli="$honey_cli" '
        BEGIN {
            print "# Managed by Honey"
        }
        /^#[[:space:]]*Managed by Honey[[:space:]]*$/ {
            next
        }
        /^Exec=/ {
            command_line = substr($0, 6)
            sub(/^[[:space:]]*/, "", command_line)

            if (substr(command_line, 1, 1) == "\"") {
                command_line = substr(command_line, 2)
                closing_quote = index(command_line, "\"")
                if (closing_quote > 0) {
                    command_line = substr(command_line, closing_quote + 1)
                } else {
                    command_line = ""
                }
            } else {
                sub(/^[^[:space:]]+/, "", command_line)
            }

            sub(/^[[:space:]]*/, "", command_line)
            printf "Exec=\"%s\" launch-codium", honey_cli
            if (command_line != "") {
                printf " %s", command_line
            }
            if (command_line !~ /%[fFuU]/) {
                printf " %%F"
            }
            printf "\n"
            next
        }
        { print }
    ' "$source" > "$tmp"

    mv -f "$tmp" "$target"
}

write_codium_honey_desktop_file() {
    mkdir -p "$LOCAL_APPLICATIONS_DIR" "$CODIUM_HONEY_USER_DATA_DIR" "$CODIUM_HONEY_EXTENSIONS_DIR"
    remember_original "$CODIUM_HONEY_DESKTOP_TARGET" "codium-honey.desktop"

    cat > "$CODIUM_HONEY_DESKTOP_TARGET" <<EOF
[Desktop Entry]
Name=VSCodium Honey
Comment=VSCodium isolated Honey render instance
GenericName=Text Editor
Exec="$ROOT_DIR/bin/honey" launch-honey-codium %F
Icon=vscodium
Type=Application
StartupNotify=false
StartupWMClass=VSCodium
Categories=TextEditor;Development;IDE;
MimeType=text/plain;inode/directory;application/x-codium-workspace;
Actions=new-empty-window;
Keywords=honey;vscodium;codium;vscode;

[Desktop Action new-empty-window]
Name=New Honey Window
Name[es]=Nueva ventana Honey
Exec="$ROOT_DIR/bin/honey" launch-honey-codium --new-window %F
Icon=vscodium
EOF
}

refresh_desktop_launchers() {
    if command_exists update-desktop-database; then
        update-desktop-database "$LOCAL_APPLICATIONS_DIR" >/dev/null 2>&1 || true
    fi

    if command_exists kbuildsycoca6; then
        kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    elif command_exists kbuildsycoca5; then
        kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
    fi
}

apply_codium_launchers() {
    local desktop_source="$CODIUM_DESKTOP_SOURCE"
    local url_desktop_source="$CODIUM_URL_DESKTOP_SOURCE"

    if [[ -f "$CODIUM_DESKTOP_TARGET" ]]; then
        desktop_source="$CODIUM_DESKTOP_TARGET"
    fi

    if [[ -f "$CODIUM_URL_DESKTOP_TARGET" ]]; then
        url_desktop_source="$CODIUM_URL_DESKTOP_TARGET"
    fi

    patch_codium_desktop_file "$desktop_source" "$CODIUM_DESKTOP_TARGET" "codium.desktop"
    patch_codium_desktop_file "$url_desktop_source" "$CODIUM_URL_DESKTOP_TARGET" "codium-url-handler.desktop"
    write_codium_honey_desktop_file
    refresh_desktop_launchers
}

restore_legacy_app_overrides() {
    restore_original "$CODIUM_FLAGS" "codium-flags.conf"
    restore_original "$CODE_FLAGS" "code-flags.conf"
    restore_original "$VSCODE_OSS_FLAGS" "vscode-oss-flags.conf"
    restore_original "$ELECTRON_FLAGS" "electron-flags.conf"
    restore_original "$CODIUM_DESKTOP_TARGET" "codium.desktop"
    restore_original "$CODIUM_URL_DESKTOP_TARGET" "codium-url-handler.desktop"
    restore_original "$CODIUM_HONEY_DESKTOP_TARGET" "codium-honey.desktop"
    refresh_desktop_launchers
}

apply_compatibility() {
    apply_gtk_config
    apply_xsettingsd_config
    apply_kde_config
    apply_firefox_chrome_config
    apply_kde_session_environment
    restore_legacy_app_overrides
    if command_exists codium || command_exists vscodium || [[ -x "$CODIUM_WRAPPER" ]]; then
        apply_codium_launchers
    fi
    ok "Compatibilidad GTK/KDE/Electron aplicada desde la sesion"
}

reset_compatibility() {
    restore_original "$HONEY_ENVIRONMENT_TARGET" "90-honey.conf"
    restore_original "$HONEY_PLASMA_ENV_TARGET" "90-honey.sh"
    restore_original "$GTK3_SETTINGS" "gtk3-settings.ini"
    restore_original "$GTK4_SETTINGS" "gtk4-settings.ini"
    restore_original "$XSETTINGSD_CONFIG" "xsettingsd.conf"
    restore_original "$KDE_GLOBALS" "kdeglobals"
    reset_firefox_chrome_config
    restore_original "$CODIUM_FLAGS" "codium-flags.conf"
    restore_original "$CODE_FLAGS" "code-flags.conf"
    restore_original "$VSCODE_OSS_FLAGS" "vscode-oss-flags.conf"
    restore_original "$ELECTRON_FLAGS" "electron-flags.conf"
    restore_original "$CODIUM_DESKTOP_TARGET" "codium.desktop"
    restore_original "$CODIUM_URL_DESKTOP_TARGET" "codium-url-handler.desktop"
    restore_original "$CODIUM_HONEY_DESKTOP_TARGET" "codium-honey.desktop"
    reset_running_session_environment
    refresh_desktop_launchers
}

apply_profile() {
    [[ -f "$PROFILE_SOURCE" ]] || die "No existe el perfil fuente: $PROFILE_SOURCE"

    mkdir -p "$FONTCONFIG_DIR"
    backup_existing_profile
    cp -f "$PROFILE_SOURCE" "$PROFILE_TARGET"
    apply_compatibility
    refresh_cache

    ok "Perfil Honey aplicado en $PROFILE_TARGET"
    warn "Reabre Firefox para cargar interfaz y trazo web; no se modifican diseños de páginas"
}

reset_profile() {
    if [[ -f "$PROFILE_TARGET" ]]; then
        if is_managed_profile; then
            rm -f "$PROFILE_TARGET"
            ok "Perfil fontconfig retirado"
        else
            warn "El archivo $PROFILE_TARGET no parece gestionado por Honey; no lo elimino"
        fi
    else
        warn "No hay perfil Honey activo en $PROFILE_TARGET"
    fi

    reset_compatibility
    refresh_cache
    ok "Honey retirado de las capas gestionadas"
}

print_match() {
    local family="$1"
    if command_exists fc-match; then
        printf '%s -> %s\n' "$family" "$(fc-match "$family" 2>/dev/null | head -n 1)"
    else
        printf '%s -> fc-match no disponible\n' "$family"
    fi
}

print_ini_value() {
    local file="$1" section="$2" key="$3"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -F= -v section="$section" -v key="$key" '
        /^\[[^]]+\][[:space:]]*$/ {
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            next
        }
        in_section && $1 == key {
            print $2
            found = 1
            exit
        }
        END {
            if (!found) {
                printf "unset"
            }
        }
    ' "$file"
}

print_xsettings_value() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -v key="$key" '$1 == key { $1 = ""; sub(/^ /, ""); print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_flag_value() {
    local file="$1" prefix="$2"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -v prefix="$prefix" 'index($0, prefix) == 1 { print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_desktop_exec() {
    local file="$1"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk '/^Exec=/ { print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_managed_file_state() {
    local file="$1"

    if [[ -f "$file" ]] && grep -q "$MARKER" "$file"; then
        printf 'active'
    elif [[ -f "$file" ]]; then
        printf 'custom'
    else
        printf 'missing'
    fi
}

status() {
    printf 'Honey %s\n' "$VERSION"

    if is_managed_profile; then
        ok "Perfil activo"
    elif [[ -f "$PROFILE_TARGET" ]]; then
        warn "Existe $PROFILE_TARGET, pero no parece gestionado por Honey"
    else
        warn "Perfil no activo"
    fi

    printf '\nRutas:\n'
    print_paths

    printf '\nFuentes resueltas:\n'
    print_match "sans-serif"
    print_match "serif"
    print_match "monospace"
    print_match "emoji"

    printf '\nCompatibilidad:\n'
    printf 'KDE environment.d -> %s\n' "$(print_managed_file_state "$HONEY_ENVIRONMENT_TARGET")"
    printf 'Plasma env hook -> %s\n' "$(print_managed_file_state "$HONEY_PLASMA_ENV_TARGET")"
    printf 'Honey FREETYPE target -> %s\n' "$HONEY_FREETYPE_PROPERTIES"
    printf 'Current process FREETYPE -> %s\n' "${FREETYPE_PROPERTIES:-unset}"
    printf 'GTK3 hintstyle -> %s\n' "$(print_ini_value "$GTK3_SETTINGS" "Settings" "gtk-xft-hintstyle")"
    printf 'GTK4 hintstyle -> %s\n' "$(print_ini_value "$GTK4_SETTINGS" "Settings" "gtk-xft-hintstyle")"
    printf 'xsettingsd hintstyle -> %s\n' "$(print_xsettings_value "$XSETTINGSD_CONFIG" "Xft/HintStyle")"
    printf 'KDE XftHintStyle -> %s\n' "$(print_ini_value "$KDE_GLOBALS" "General" "XftHintStyle")"
    printf 'KDE font -> %s\n' "$(print_ini_value "$KDE_GLOBALS" "General" "font")"
    printf 'Firefox chrome -> %s\n' "$(firefox_chrome_state)"
    printf 'Firefox web render -> %s\n' "$(firefox_web_state)"
    printf 'Legacy Codium flags -> %s\n' "$(print_flag_value "$CODIUM_FLAGS" "--font-render-hinting=")"
    printf 'Codium desktop -> %s\n' "$(print_managed_file_state "$CODIUM_DESKTOP_TARGET")"
}

doctor() {
    printf 'Honey %s\n' "$VERSION"
    print_paths

    printf '\nDependencias:\n'
    if command_exists bash; then ok "bash encontrado"; else die "bash no encontrado"; fi
    if command_exists fc-cache; then ok "fc-cache encontrado"; else warn "fc-cache no encontrado"; fi
    if command_exists fc-match; then ok "fc-match encontrado"; else warn "fc-match no encontrado"; fi
    if [[ -f "$PROFILE_SOURCE" ]]; then ok "perfil fuente encontrado"; else die "perfil fuente no encontrado"; fi
    if [[ -e "$KDE_GLOBALS" ]]; then ok "kdeglobals encontrado"; else warn "kdeglobals no encontrado"; fi
    if [[ -d "$FIREFOX_CONFIG_DIR" ]]; then ok "perfiles de Firefox encontrados"; else warn "perfiles de Firefox no encontrados"; fi
    if [[ -e "$GTK3_SETTINGS" ]]; then ok "GTK3 settings encontrado"; else warn "GTK3 settings no encontrado"; fi
    if [[ -e "$GTK4_SETTINGS" ]]; then ok "GTK4 settings encontrado"; else warn "GTK4 settings no encontrado"; fi
    if command_exists codium || command_exists vscodium || [[ -x "$CODIUM_WRAPPER" ]]; then
        ok "VSCodium encontrado"
    else
        warn "VSCodium no encontrado; se omite su lanzador especializado"
    fi
    if [[ "$(print_managed_file_state "$CODIUM_DESKTOP_TARGET")" == "active" ]]; then
        ok "launcher KDE de VSCodium gestionado por Honey"
    else
        warn "launcher KDE de VSCodium no gestionado por Honey"
    fi
    if [[ -f "$HONEY_ENVIRONMENT_TARGET" ]]; then ok "environment.d Honey encontrado"; else warn "environment.d Honey no encontrado"; fi
    if [[ -f "$HONEY_PLASMA_ENV_TARGET" ]]; then ok "hook Plasma Honey encontrado"; else warn "hook Plasma Honey no encontrado"; fi
    if [[ -d "$(dirname "$PROFILE_TARGET")" || -w "${XDG_CONFIG_HOME:-$HOME/.config}" ]]; then
        ok "directorio de configuracion disponible"
    else
        warn "no se puede confirmar escritura en el directorio de configuracion"
    fi
}

prepare_launch_environment() {
    export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
    export HONEY_FONTCONFIG="$PROFILE_TARGET"
    export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"
}

resolve_codium_bin() {
    local bin=""

    if command_exists codium; then
        bin="$(command -v codium)"
    elif command_exists vscodium; then
        bin="$(command -v vscodium)"
    elif [[ -x "$CODIUM_WRAPPER" ]]; then
        bin="$CODIUM_WRAPPER"
    fi

    [[ -n "$bin" ]] || return 1
    printf '%s\n' "$bin"
}

launch_codium() {
    local bin

    bin="$(resolve_codium_bin || true)"
    [[ -n "$bin" ]] || die "No encontre codium"

    prepare_launch_environment
    "$bin" "${HONEY_ELECTRON_FLAGS[@]}" "$@"
}

launch_honey_codium() {
    local bin

    bin="$(resolve_codium_bin || true)"
    [[ -n "$bin" ]] || die "No encontre codium"
    mkdir -p "$CODIUM_HONEY_USER_DATA_DIR" "$CODIUM_HONEY_EXTENSIONS_DIR"

    prepare_launch_environment
    "$bin" \
        --user-data-dir "$CODIUM_HONEY_USER_DATA_DIR" \
        --extensions-dir "$CODIUM_HONEY_EXTENSIONS_DIR" \
        "${HONEY_ELECTRON_FLAGS[@]}" \
        "$@"
}

main() {
    local command_name="${1:-help}"
    shift || true

    case "$command_name" in
        apply) apply_profile ;;
        reset) reset_profile ;;
        launch-codium) launch_codium "$@" ;;
        launch-honey-codium) launch_honey_codium "$@" ;;
        status) status ;;
        doctor) doctor ;;
        paths) print_paths ;;
        version|-v|--version) printf 'Honey %s\n' "$VERSION" ;;
        help|-h|--help) usage ;;
        *)
            usage
            die "Comando desconocido: $command_name"
            ;;
    esac
}

main "$@"
