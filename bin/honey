#!/usr/bin/env bash
# Honey CLI

set -Eeuo pipefail

VERSION="0.7.0"

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" == /* ]] || SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done

ROOT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
if [[ -d "$HOME/.cargo/bin" && ":$PATH:" != *":$HOME/.cargo/bin:"* ]]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi
PROFILE_SOURCE="$ROOT_DIR/config/fontconfig/99-honey.conf"
FONTCONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d"
PROFILE_TARGET="$FONTCONFIG_DIR/99-honey.conf"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/honey"
BACKUP_DIR="$STATE_DIR/backups"
ORIGINAL_DIR="$STATE_DIR/originals"
MARKER="Managed by Honey"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
ENVIRONMENT_DIR="$CONFIG_HOME/environment.d"
PLASMA_ENV_DIR="$CONFIG_HOME/plasma-workspace/env"
HONEY_ENVIRONMENT_TARGET="$ENVIRONMENT_DIR/90-honey.conf"
HONEY_PLASMA_ENV_TARGET="$PLASMA_ENV_DIR/90-honey.sh"
HONEY_ACTIVE_VALUE="1"
HONEY_HINTSTYLE="hintnone"
HONEY_FREETYPE_PROPERTIES="truetype:interpreter-version=40 cff:no-stem-darkening=0 cff:darkening-parameters=500,300,1000,200,1667,100,2333,0 autofitter:no-stem-darkening=0 autofitter:darkening-parameters=500,300,1000,200,1667,100,2333,0 type1:no-stem-darkening=0 t1mode:no-stem-darkening=0"
GTK3_SETTINGS="$CONFIG_HOME/gtk-3.0/settings.ini"
GTK4_SETTINGS="$CONFIG_HOME/gtk-4.0/settings.ini"
XSETTINGSD_CONFIG="$CONFIG_HOME/xsettingsd/xsettingsd.conf"
KDE_GLOBALS="$CONFIG_HOME/kdeglobals"
FIREFOX_CONFIG_DIR="$HOME/.mozilla/firefox"
FIREFOX_PROFILES_INI="$FIREFOX_CONFIG_DIR/profiles.ini"
FIREFOX_CHROME_CSS_SOURCE="$ROOT_DIR/config/firefox/userChrome.css"
FIREFOX_WEB_CSS_SOURCE="$ROOT_DIR/config/firefox/userContent.css"

ELECTRON_FLAGS="$CONFIG_HOME/electron-flags.conf"
CODIUM_FLAGS="$CONFIG_HOME/codium-flags.conf"
CODE_FLAGS="$CONFIG_HOME/code-flags.conf"
VSCODE_OSS_FLAGS="$CONFIG_HOME/vscode-oss-flags.conf"
CURSOR_FLAGS="$CONFIG_HOME/cursor-flags.conf"
ANTIGRAVITY_FLAGS="$CONFIG_HOME/antigravity-flags.conf"
OBSIDIAN_FLAGS="$CONFIG_HOME/obsidian-flags.conf"
SLACK_FLAGS="$CONFIG_HOME/slack-flags.conf"
DISCORD_FLAGS="$CONFIG_HOME/discord-flags.conf"
ELEMENT_FLAGS="$CONFIG_HOME/element-flags.conf"
SPOTIFY_FLAGS="$CONFIG_HOME/spotify-flags.conf"
CHROME_FLAGS="$CONFIG_HOME/chrome-flags.conf"
CHROMIUM_FLAGS="$CONFIG_HOME/chromium-flags.conf"
BRAVE_FLAGS="$CONFIG_HOME/brave-flags.conf"

LOCAL_APPLICATIONS_DIR="$DATA_HOME/applications"
HONEY_ELECTRON_FLAGS=(--disable-lcd-text --font-render-hinting=none --enable-font-antialiasing --force-color-profile=srgb)

green='\033[0;32m'
yellow='\033[1;33m'
red='\033[0;31m'
reset='\033[0m'

ok() { printf '%bOK%b %s\n' "$green" "$reset" "$1"; }
warn() { printf '%bWARN%b %s\n' "$yellow" "$reset" "$1"; }
die() { printf '%bERROR%b %s\n' "$red" "$reset" "$1" >&2; exit 1; }

usage() {
    cat <<'EOF'
Honey

Uso:
  honey apply          Activa fontconfig y compatibilidad GTK/KDE/Electron
  honey reset          Retira Honey y restaura configs originales conocidas
  honey install-system Instala Honey Rust Core como reemplazo nativo de libfreetype.so.6 (sudo)
  honey status-system  Muestra si el sistema ejecuta Honey Rust Core o FreeType
  honey restore-system Restaura libfreetype.so.6 oficial de la distribucion (sudo)
  honey launch-electron COMANDO [ARGS] Abre cualquier app Electron con el render macOS de Honey
  honey launch-codium [RUTA] Abre Codium con el render macOS de Honey
  honey launch-code [RUTA] Abre VS Code con el render macOS de Honey
  honey launch-cursor [RUTA] Abre Cursor con el render macOS de Honey
  honey profile set [gnome|kde]  Activa perfil especializado de escritorio (GNOME/KDE)
  honey profile status           Muestra el perfil activo y parametros de escritorio
  honey status         Muestra estado y muestras de fontconfig
  honey doctor         Revisa dependencias y rutas
  honey paths          Muestra rutas usadas
  honey version        Muestra la version
  honey help           Muestra esta ayuda

Honey no necesita sudo. Sus cambios viven en:
  ~/.config/fontconfig/conf.d/99-honey.conf

Tambien sincroniza, con respaldo, estas capas cuando existen:
  GTK 3/4, xsettingsd, KDE/kdeglobals y entorno de sesion KDE/DBus.
  Electron: flags globales e individuales (~/.config/*-flags.conf).
  Firefox recibe una hoja userChrome.css solo para su interfaz.
EOF
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

print_paths() {
    printf 'ROOT_DIR=%s\n' "$ROOT_DIR"
    printf 'PROFILE_SOURCE=%s\n' "$PROFILE_SOURCE"
    printf 'PROFILE_TARGET=%s\n' "$PROFILE_TARGET"
    printf 'STATE_DIR=%s\n' "$STATE_DIR"
    printf 'BACKUP_DIR=%s\n' "$BACKUP_DIR"
    printf 'ORIGINAL_DIR=%s\n' "$ORIGINAL_DIR"
    printf 'HONEY_ENVIRONMENT_TARGET=%s\n' "$HONEY_ENVIRONMENT_TARGET"
    printf 'HONEY_PLASMA_ENV_TARGET=%s\n' "$HONEY_PLASMA_ENV_TARGET"
    printf 'GTK3_SETTINGS=%s\n' "$GTK3_SETTINGS"
    printf 'GTK4_SETTINGS=%s\n' "$GTK4_SETTINGS"
    printf 'XSETTINGSD_CONFIG=%s\n' "$XSETTINGSD_CONFIG"
    printf 'KDE_GLOBALS=%s\n' "$KDE_GLOBALS"
    printf 'FIREFOX_CONFIG_DIR=%s\n' "$FIREFOX_CONFIG_DIR"
    printf 'FIREFOX_PROFILES_INI=%s\n' "$FIREFOX_PROFILES_INI"
    printf 'FIREFOX_CHROME_CSS_SOURCE=%s\n' "$FIREFOX_CHROME_CSS_SOURCE"
    printf 'FIREFOX_WEB_CSS_SOURCE=%s\n' "$FIREFOX_WEB_CSS_SOURCE"
    printf 'CODIUM_FLAGS=%s\n' "$CODIUM_FLAGS"
}

is_managed_profile() {
    [[ -f "$PROFILE_TARGET" ]] && grep -q "$MARKER" "$PROFILE_TARGET"
}

backup_existing_profile() {
    [[ -f "$PROFILE_TARGET" ]] || return 0
    is_managed_profile && return 0

    mkdir -p "$BACKUP_DIR"
    local stamp backup_path
    stamp="$(date +%Y%m%d_%H%M%S)"
    backup_path="$BACKUP_DIR/99-honey.conf.$stamp.bak"
    cp -f "$PROFILE_TARGET" "$backup_path"
    warn "Ya existia un perfil con ese nombre. Respaldo creado en $backup_path"
}

remember_original() {
    local file="$1" label="$2"
    local original_file="$ORIGINAL_DIR/$label"
    local missing_file="$ORIGINAL_DIR/$label.missing"

    mkdir -p "$ORIGINAL_DIR"

    if [[ -f "$original_file" || -f "$missing_file" ]]; then
        return 0
    fi

    if [[ -e "$file" ]]; then
        cp -f "$file" "$original_file"
    else
        : > "$missing_file"
    fi
}

restore_original() {
    local file="$1" label="$2"
    local original_file="$ORIGINAL_DIR/$label"
    local missing_file="$ORIGINAL_DIR/$label.missing"

    if [[ -f "$original_file" ]]; then
        mkdir -p "$(dirname "$file")"
        cp -f "$original_file" "$file"
        ok "Restaurado $file"
    elif [[ -f "$missing_file" ]]; then
        rm -f "$file"
        ok "Retirado $file"
    fi
}

refresh_cache() {
    if command_exists fc-cache; then
        fc-cache -f >/dev/null 2>&1 || warn "No se pudo regenerar la cache de fuentes"
    else
        warn "fc-cache no esta disponible; reinicia tus aplicaciones despues de aplicar cambios"
    fi
}

write_session_environment() {
    mkdir -p "$ENVIRONMENT_DIR" "$PLASMA_ENV_DIR"
    remember_original "$HONEY_ENVIRONMENT_TARGET" "90-honey.conf"
    remember_original "$HONEY_PLASMA_ENV_TARGET" "90-honey.sh"

    cat > "$HONEY_ENVIRONMENT_TARGET" <<EOF
# Managed by Honey
HONEY_ACTIVE=$HONEY_ACTIVE_VALUE
HONEY_FONTCONFIG=$PROFILE_TARGET
FREETYPE_PROPERTIES=$HONEY_FREETYPE_PROPERTIES
EOF

    cat > "$HONEY_PLASMA_ENV_TARGET" <<EOF
#!/usr/bin/env sh
# Managed by Honey
export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
export HONEY_FONTCONFIG="$PROFILE_TARGET"
export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
fi
EOF

    chmod +x "$HONEY_PLASMA_ENV_TARGET"
}

apply_running_session_environment() {
    export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
    export HONEY_FONTCONFIG="$PROFILE_TARGET"
    export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"

    if command_exists systemctl; then
        systemctl --user import-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || \
            warn "No pude importar el entorno Honey a systemd user en esta sesion"
    fi

    if command_exists dbus-update-activation-environment; then
        dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || \
            warn "No pude importar el entorno Honey a DBus en esta sesion"
    fi
}

reset_running_session_environment() {
    unset HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES

    if command_exists systemctl; then
        systemctl --user unset-environment HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
    fi

    if command_exists dbus-update-activation-environment; then
        dbus-update-activation-environment --systemd HONEY_ACTIVE HONEY_FONTCONFIG FREETYPE_PROPERTIES >/dev/null 2>&1 || true
    fi
}

apply_kde_session_environment() {
    write_session_environment
    apply_running_session_environment
}

set_ini_value() {
    local file="$1" section="$2" key="$3" value="$4"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || printf '[%s]\n' "$section" > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-ini.XXXXXX")"
    awk -v section="$section" -v key="$key" -v value="$value" '
        BEGIN {
            in_section = 0
            seen_section = 0
            key_written = 0
        }
        function write_key_if_needed() {
            if (seen_section && !key_written) {
                print key "=" value
                key_written = 1
            }
        }
        /^\[[^]]+\][[:space:]]*$/ {
            if (in_section) {
                write_key_if_needed()
            }
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            if (in_section) {
                seen_section = 1
            }
            print
            next
        }
        {
            if (in_section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=") {
                print key "=" value
                key_written = 1
                next
            }
            print
        }
        END {
            if (!seen_section) {
                print ""
                print "[" section "]"
                print key "=" value
            } else if (in_section) {
                write_key_if_needed()
            }
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

remove_ini_value_if_equals() {
    local file="$1" section="$2" key="$3" expected="$4"
    local tmp

    [[ -f "$file" ]] || return 0
    tmp="$(mktemp "$STATE_DIR/honey-ini-remove.XXXXXX")"
    awk -F= -v section="$section" -v key="$key" -v expected="$expected" '
        BEGIN {
            in_section = 0
        }
        /^\[[^]]+\][[:space:]]*$/ {
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            print
            next
        }
        {
            if (in_section && $1 == key && $2 == expected) {
                next
            }
            print
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

set_xsettings_value() {
    local file="$1" key="$2" value="$3"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || : > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-xsettings.XXXXXX")"
    awk -v key="$key" -v value="$value" '
        BEGIN { written = 0 }
        $1 == key {
            print key " " value
            written = 1
            next
        }
        { print }
        END {
            if (!written) {
                print key " " value
            }
        }
    ' "$file" > "$tmp"
    mv -f "$tmp" "$file"
}

ensure_flag() {
    local file="$1" pattern="$2" line="$3"
    local tmp

    mkdir -p "$(dirname "$file")" "$STATE_DIR"
    [[ -f "$file" ]] || : > "$file"

    tmp="$(mktemp "$STATE_DIR/honey-flags.XXXXXX")"
    awk -v pattern="$pattern" '$0 !~ pattern { print }' "$file" > "$tmp"
    printf '%s\n' "$line" >> "$tmp"
    mv -f "$tmp" "$file"
}

apply_gtk_config() {
    local file label

    for file in "$GTK3_SETTINGS" "$GTK4_SETTINGS"; do
        if [[ "$file" == "$GTK3_SETTINGS" ]]; then
            label="gtk3-settings.ini"
        else
            label="gtk4-settings.ini"
        fi

        remember_original "$file" "$label"
        set_ini_value "$file" "Settings" "gtk-xft-antialias" "1"
        set_ini_value "$file" "Settings" "gtk-xft-hinting" "1"
        set_ini_value "$file" "Settings" "gtk-xft-hintstyle" "$HONEY_HINTSTYLE"
        set_ini_value "$file" "Settings" "gtk-xft-rgba" "none"
        if [[ -f "$ORIGINAL_DIR/$label.missing" ]]; then
            remove_ini_value_if_equals "$file" "Settings" "gtk-font-name" "Inter Medium 10.5"
        fi
    done

    if command_exists gsettings; then
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *"GNOME"* ]] || [[ "${XDG_CURRENT_DESKTOP:-}" == *"gnome"* ]]; then
            gsettings set org.gnome.desktop.interface font-hinting 'none' 2>/dev/null || true
            gsettings set org.gnome.desktop.interface font-antialiasing 'grayscale' 2>/dev/null || true
            gsettings set org.gnome.desktop.interface font-rgba-order 'none' 2>/dev/null || true
        fi
    fi
}

browser_root_dirs() {
    local d
    for d in \
        "$CONFIG_HOME/mozilla/firefox" \
        "$HOME/.mozilla/firefox" \
        "$CONFIG_HOME/zen" \
        "$HOME/.zen" \
        "$CONFIG_HOME/floorp" \
        "$HOME/.floorp" \
        "$CONFIG_HOME/waterfox" \
        "$HOME/.waterfox" \
        "$CONFIG_HOME/librewolf" \
        "$HOME/.librewolf" \
        "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox" \
        "$HOME/.var/app/app.zen_browser.zen/.zen" \
        "$HOME/.var/app/one.floorp.Floorp/.floorp" \
        "$HOME/.var/app/io.gitlab.librewolf-community/.librewolf" \
        "$HOME/.var/app/net.waterfox.waterfox/.waterfox"
    do
        [[ -d "$d" ]] && printf '%s\n' "$d"
    done | sort -u
}

firefox_profile_dirs() {
    local root_dir
    while IFS= read -r root_dir; do
        [[ -n "$root_dir" ]] || continue
        local profiles_ini="$root_dir/profiles.ini"
        if [[ -f "$profiles_ini" ]]; then
            awk -F= -v root="$root_dir" '
                function emit() {
                    if (path == "") {
                        return
                    }
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", path)
                    if (relative == "1") {
                        print root "/" path
                    } else {
                        print path
                    }
                }
                /^\[Profile[0-9]+\][[:space:]]*$/ {
                    if (in_profile) {
                        emit()
                    }
                    path = ""
                    relative = "1"
                    in_profile = 1
                    next
                }
                /^\[/ {
                    if (in_profile) {
                        emit()
                    }
                    path = ""
                    in_profile = 0
                    next
                }
                in_profile && $1 == "Path" {
                    path = $2
                    next
                }
                in_profile && $1 == "IsRelative" {
                    relative = $2
                    next
                }
                END {
                    if (in_profile) {
                        emit()
                    }
                }
            ' "$profiles_ini"
        elif [[ -d "$root_dir" ]]; then
            find "$root_dir" -mindepth 1 -maxdepth 2 -type f -name prefs.js -printf '%h\n' 2>/dev/null
        fi
    done < <(browser_root_dirs) | while IFS= read -r profile; do
        [[ -f "$profile/prefs.js" ]] && printf '%s\n' "$profile"
    done | sort -u
}

firefox_profile_label() {
    local profile="$1"
    local digest

    if command_exists sha256sum; then
        digest="$(printf '%s' "$profile" | sha256sum | awk '{ print substr($1, 1, 16) }')"
    else
        digest="$(printf '%s' "$profile" | cksum | awk '{ print $1 }')"
    fi
    printf 'firefox-%s' "$digest"
}

write_firefox_user_chrome() {
    local profile="$1" label="$2" file="$1/chrome/userChrome.css"
    local original_file="$ORIGINAL_DIR/$label-userChrome.css"

    mkdir -p "$profile/chrome"
    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    printf '\n' >> "$file"
    cat "$FIREFOX_CHROME_CSS_SOURCE" >> "$file"
}

write_firefox_user_content() {
    local profile="$1" label="$2" file="$1/chrome/userContent.css"
    local original_file="$ORIGINAL_DIR/$label-userContent.css"

    mkdir -p "$profile/chrome"
    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    printf '\n' >> "$file"
    cat "$FIREFOX_WEB_CSS_SOURCE" >> "$file"
}

write_firefox_user_js() {
    local profile="$1" label="$2" file="$profile/user.js"
    local original_file="$ORIGINAL_DIR/$label-user.js"

    if [[ -f "$original_file" ]]; then
        cp -f "$original_file" "$file"
    else
        : > "$file"
    fi
    cat >> "$file" <<'EOF'

// Managed by Honey: enable browser-chrome userChrome.css.
user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);
EOF
}

apply_firefox_chrome_config() {
    local profile label
    local found=0

    [[ -f "$FIREFOX_CHROME_CSS_SOURCE" && -f "$FIREFOX_WEB_CSS_SOURCE" ]] || return 0
    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        label="$(firefox_profile_label "$profile")"
        remember_original "$profile/chrome/userContent.css" "$label-userContent.css"
        remember_original "$profile/chrome/userChrome.css" "$label-userChrome.css"
        remember_original "$profile/user.js" "$label-user.js"
        write_firefox_user_content "$profile" "$label"
        write_firefox_user_chrome "$profile" "$label"
        write_firefox_user_js "$profile" "$label"
    done < <(firefox_profile_dirs)

    if (( found )); then
        ok "Render de interfaz y trazo web neutral aplicado en sus perfiles Firefox"
    else
        warn "No encontre perfiles de Firefox; se omitio el render de interfaz"
    fi
}

reset_firefox_chrome_config() {
    local profile label

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        label="$(firefox_profile_label "$profile")"
        restore_original "$profile/chrome/userContent.css" "$label-userContent.css"
        restore_original "$profile/chrome/userChrome.css" "$label-userChrome.css"
        restore_original "$profile/user.js" "$label-user.js"
    done < <(firefox_profile_dirs)
}

firefox_chrome_state() {
    local profile file
    local found=0 active=0

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        file="$profile/chrome/userChrome.css"
        if [[ -f "$file" ]] && grep -q 'Managed by Honey' "$file"; then
            active=$((active + 1))
        fi
    done < <(firefox_profile_dirs)

    if (( found == 0 )); then
        printf 'sin perfiles'
    else
        printf '%s/%s perfiles activos' "$active" "$found"
    fi
}

firefox_web_state() {
    local profile file
    local found=0 active=0

    while IFS= read -r profile; do
        [[ -n "$profile" ]] || continue
        found=1
        file="$profile/chrome/userContent.css"
        if [[ -f "$file" ]] && grep -q 'Managed by Honey' "$file"; then
            active=$((active + 1))
        fi
    done < <(firefox_profile_dirs)

    if (( found == 0 )); then
        printf 'sin perfiles'
    else
        printf '%s/%s perfiles activos' "$active" "$found"
    fi
}

apply_xsettingsd_config() {
    remember_original "$XSETTINGSD_CONFIG" "xsettingsd.conf"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/Antialias" "1"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/Hinting" "1"
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/HintStyle" "\"$HONEY_HINTSTYLE\""
    set_xsettings_value "$XSETTINGSD_CONFIG" "Xft/RGBA" "\"none\""
}

apply_kde_config() {
    remember_original "$KDE_GLOBALS" "kdeglobals"
    set_ini_value "$KDE_GLOBALS" "General" "XftAntialias" "true"
    set_ini_value "$KDE_GLOBALS" "General" "XftHintStyle" "$HONEY_HINTSTYLE"
    set_ini_value "$KDE_GLOBALS" "General" "XftSubPixel" "none"
}

electron_flags_files() {
    printf '%s\n' "$ELECTRON_FLAGS" "$CODIUM_FLAGS" "$CODE_FLAGS" "$VSCODE_OSS_FLAGS" \
                  "$CURSOR_FLAGS" "$ANTIGRAVITY_FLAGS" "$OBSIDIAN_FLAGS" "$SLACK_FLAGS" \
                  "$DISCORD_FLAGS" "$ELEMENT_FLAGS" "$SPOTIFY_FLAGS" "$CHROME_FLAGS" \
                  "$CHROMIUM_FLAGS" "$BRAVE_FLAGS"
    local v
    for v in {16..35}; do
        printf '%s/electron%d-flags.conf\n' "$CONFIG_HOME" "$v"
    done

    local app_dir
    for app_dir in "$HOME"/.var/app/*/config; do
        [[ -d "$app_dir" ]] || continue
        printf '%s/electron-flags.conf\n' "$app_dir"
        printf '%s/chrome-flags.conf\n' "$app_dir"
        printf '%s/chromium-flags.conf\n' "$app_dir"
        printf '%s/brave-flags.conf\n' "$app_dir"
        printf '%s/code-flags.conf\n' "$app_dir"
        printf '%s/codium-flags.conf\n' "$app_dir"
    done
}

should_apply_flags_file() {
    local file="$1"
    local base
    base="$(basename "$file")"

    if [[ -e "$file" ]]; then
        return 0
    fi

    case "$base" in
        electron-flags.conf|electron*-flags.conf)
            return 0
            ;;
        codium-flags.conf)
            [[ -d "$CONFIG_HOME/VSCodium" ]] || command_exists codium || command_exists vscodium
            ;;
        code-flags.conf)
            [[ -d "$CONFIG_HOME/Code" ]] || command_exists code
            ;;
        vscode-oss-flags.conf)
            [[ -d "$CONFIG_HOME/Code - OSS" ]] || command_exists code-oss
            ;;
        cursor-flags.conf)
            [[ -d "$CONFIG_HOME/Cursor" ]] || command_exists cursor
            ;;
        antigravity-flags.conf)
            [[ -d "$CONFIG_HOME/antigravity" || -d "$CONFIG_HOME/antigravity-ide" ]] || command_exists antigravity
            ;;
        obsidian-flags.conf)
            [[ -d "$CONFIG_HOME/obsidian" ]] || command_exists obsidian
            ;;
        slack-flags.conf)
            [[ -d "$CONFIG_HOME/Slack" ]] || command_exists slack
            ;;
        discord-flags.conf)
            [[ -d "$CONFIG_HOME/discord" ]] || command_exists discord
            ;;
        element-flags.conf)
            [[ -d "$CONFIG_HOME/Element" ]] || command_exists element-desktop
            ;;
        spotify-flags.conf)
            [[ -d "$CONFIG_HOME/spotify" ]] || command_exists spotify
            ;;
        chrome-flags.conf)
            [[ -d "$CONFIG_HOME/google-chrome" ]] || command_exists google-chrome || command_exists google-chrome-stable
            ;;
        chromium-flags.conf)
            [[ -d "$CONFIG_HOME/chromium" ]] || command_exists chromium || command_exists chromium-freeworld
            ;;
        brave-flags.conf)
            [[ -d "$CONFIG_HOME/BraveSoftware" ]] || command_exists brave || command_exists brave-browser
            ;;
        *)
            return 1
            ;;
    esac
}

apply_electron_flags() {
    local file label

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        should_apply_flags_file "$file" || continue
        label="$(basename "$file")"
        remember_original "$file" "$label"
        ensure_flag "$file" "^--font-render-hinting=" "--font-render-hinting=none"
        ensure_flag "$file" "^--disable-lcd-text$" "--disable-lcd-text"
        ensure_flag "$file" "^--enable-font-antialiasing$" "--enable-font-antialiasing"
        ensure_flag "$file" "^--force-color-profile=" "--force-color-profile=srgb"
    done < <(electron_flags_files)
}

reset_electron_flags() {
    local file label

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue
        label="$(basename "$file")"
        restore_original "$file" "$label"
    done < <(electron_flags_files)
}

refresh_desktop_launchers() {
    if command_exists update-desktop-database; then
        update-desktop-database "$LOCAL_APPLICATIONS_DIR" >/dev/null 2>&1 || true
    fi

    if command_exists kbuildsycoca6; then
        kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    elif command_exists kbuildsycoca5; then
        kbuildsycoca5 --noincremental >/dev/null 2>&1 || true
    fi
}

cleanup_legacy_codium_launchers() {
    local changed=0
    local codium_desktop="$LOCAL_APPLICATIONS_DIR/codium.desktop"
    local codium_url_desktop="$LOCAL_APPLICATIONS_DIR/codium-url-handler.desktop"
    local codium_honey_desktop="$LOCAL_APPLICATIONS_DIR/codium-honey.desktop"

    if [[ -f "$codium_honey_desktop" ]]; then
        rm -f "$codium_honey_desktop"
        changed=1
    fi

    if [[ -f "$codium_desktop" ]] && grep -q "$MARKER" "$codium_desktop"; then
        restore_original "$codium_desktop" "codium.desktop"
        rm -f "$ORIGINAL_DIR/codium.desktop" "$ORIGINAL_DIR/codium.desktop.missing"
        changed=1
    fi

    if [[ -f "$codium_url_desktop" ]] && grep -q "$MARKER" "$codium_url_desktop"; then
        restore_original "$codium_url_desktop" "codium-url-handler.desktop"
        rm -f "$ORIGINAL_DIR/codium-url-handler.desktop" "$ORIGINAL_DIR/codium-url-handler.desktop.missing"
        changed=1
    fi

    rm -f "$ORIGINAL_DIR/codium-honey.desktop" "$ORIGINAL_DIR/codium-honey.desktop.missing"

    if (( changed )); then
        refresh_desktop_launchers
        ok "Lanzadores legacy de Codium limpiados y restaurados"
    fi
}

apply_flatpak_config() {
    if command_exists flatpak; then
        flatpak override --user \
            --filesystem=xdg-config/fontconfig:ro \
            --filesystem=xdg-data/fonts:ro \
            --filesystem=~/.local/share/fonts:ro \
            --env=HONEY_ACTIVE="$HONEY_ACTIVE_VALUE" \
            --env=HONEY_FONTCONFIG="$PROFILE_TARGET" \
            --env=FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES" \
            >/dev/null 2>&1 || warn "No se pudieron aplicar overrides de Flatpak"
        ok "Overrides de Flatpak aplicados (fontconfig y FREETYPE_PROPERTIES)"
    fi
}

reset_flatpak_config() {
    if command_exists flatpak; then
        flatpak override --user --reset >/dev/null 2>&1 || true
    fi
}

apply_compatibility() {
    apply_gtk_config
    apply_xsettingsd_config
    apply_kde_config
    apply_firefox_chrome_config
    apply_kde_session_environment
    apply_electron_flags
    apply_flatpak_config
    cleanup_legacy_codium_launchers
    ok "Compatibilidad GTK/KDE/Electron/Flatpak aplicada desde la sesion"
}

reset_compatibility() {
    restore_original "$HONEY_ENVIRONMENT_TARGET" "90-honey.conf"
    restore_original "$HONEY_PLASMA_ENV_TARGET" "90-honey.sh"
    restore_original "$GTK3_SETTINGS" "gtk3-settings.ini"
    restore_original "$GTK4_SETTINGS" "gtk4-settings.ini"
    restore_original "$XSETTINGSD_CONFIG" "xsettingsd.conf"
    restore_original "$KDE_GLOBALS" "kdeglobals"
    reset_firefox_chrome_config
    reset_electron_flags
    reset_flatpak_config
    cleanup_legacy_codium_launchers
    reset_running_session_environment
    refresh_desktop_launchers

    if command_exists gsettings; then
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *"GNOME"* ]] || [[ "${XDG_CURRENT_DESKTOP:-}" == *"gnome"* ]]; then
            gsettings reset org.gnome.desktop.interface font-hinting 2>/dev/null || true
            gsettings reset org.gnome.desktop.interface font-antialiasing 2>/dev/null || true
            gsettings reset org.gnome.desktop.interface font-rgba-order 2>/dev/null || true
        fi
    fi
    rm -f "$STATE_DIR/profile"
}

apply_profile() {
    [[ -f "$PROFILE_SOURCE" ]] || die "No existe el perfil fuente: $PROFILE_SOURCE"

    mkdir -p "$FONTCONFIG_DIR"
    backup_existing_profile
    cp -f "$PROFILE_SOURCE" "$PROFILE_TARGET"
    apply_compatibility
    refresh_cache

    ok "Perfil Honey aplicado en $PROFILE_TARGET"
    warn "Reabre Firefox para cargar interfaz y trazo web; no se modifican diseños de páginas"
}

reset_profile() {
    if [[ -f "$PROFILE_TARGET" ]]; then
        if is_managed_profile; then
            rm -f "$PROFILE_TARGET"
            ok "Perfil fontconfig retirado"
        else
            warn "El archivo $PROFILE_TARGET no parece gestionado por Honey; no lo elimino"
        fi
    else
        warn "No hay perfil Honey activo en $PROFILE_TARGET"
    fi

    reset_compatibility
    refresh_cache
    ok "Honey retirado de las capas gestionadas"
}

print_match() {
    local family="$1"
    if command_exists fc-match; then
        printf '%s -> %s\n' "$family" "$(fc-match "$family" 2>/dev/null | head -n 1)"
    else
        printf '%s -> fc-match no disponible\n' "$family"
    fi
}

print_ini_value() {
    local file="$1" section="$2" key="$3"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -F= -v section="$section" -v key="$key" '
        /^\[[^]]+\][[:space:]]*$/ {
            current = $0
            gsub(/^\[/, "", current)
            gsub(/\][[:space:]]*$/, "", current)
            in_section = (current == section)
            next
        }
        in_section && $1 == key {
            print $2
            found = 1
            exit
        }
        END {
            if (!found) {
                printf "unset"
            }
        }
    ' "$file"
}

print_xsettings_value() {
    local file="$1" key="$2"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -v key="$key" '$1 == key { $1 = ""; sub(/^ /, ""); print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_flag_value() {
    local file="$1" prefix="$2"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk -v prefix="$prefix" 'index($0, prefix) == 1 { print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_desktop_exec() {
    local file="$1"
    [[ -f "$file" ]] || {
        printf 'missing'
        return 0
    }

    awk '/^Exec=/ { print; found = 1; exit } END { if (!found) printf "unset" }' "$file"
}

print_managed_file_state() {
    local file="$1"

    if [[ -f "$file" ]] && grep -q "$MARKER" "$file"; then
        printf 'active'
    elif [[ -f "$file" ]]; then
        printf 'custom'
    else
        printf 'missing'
    fi
}

status() {
    printf 'Honey %s\n' "$VERSION"

    if is_managed_profile; then
        ok "Perfil activo"
    elif [[ -f "$PROFILE_TARGET" ]]; then
        warn "Existe $PROFILE_TARGET, pero no parece gestionado por Honey"
    else
        warn "Perfil no activo"
    fi

    printf '\nRutas:\n'
    print_paths

    printf '\nFuentes resueltas:\n'
    print_match "sans-serif"
    print_match "serif"
    print_match "monospace"
    print_match "emoji"

    printf '\nCompatibilidad:\n'
    printf 'KDE environment.d -> %s\n' "$(print_managed_file_state "$HONEY_ENVIRONMENT_TARGET")"
    printf 'Plasma env hook -> %s\n' "$(print_managed_file_state "$HONEY_PLASMA_ENV_TARGET")"
    printf 'Honey FREETYPE target -> %s\n' "$HONEY_FREETYPE_PROPERTIES"
    printf 'Current process FREETYPE -> %s\n' "${FREETYPE_PROPERTIES:-unset}"
    printf 'GTK3 hintstyle -> %s\n' "$(print_ini_value "$GTK3_SETTINGS" "Settings" "gtk-xft-hintstyle")"
    printf 'GTK4 hintstyle -> %s\n' "$(print_ini_value "$GTK4_SETTINGS" "Settings" "gtk-xft-hintstyle")"
    printf 'xsettingsd hintstyle -> %s\n' "$(print_xsettings_value "$XSETTINGSD_CONFIG" "Xft/HintStyle")"
    printf 'KDE XftHintStyle -> %s\n' "$(print_ini_value "$KDE_GLOBALS" "General" "XftHintStyle")"
    printf 'KDE font -> %s\n' "$(print_ini_value "$KDE_GLOBALS" "General" "font")"
    printf 'Firefox chrome -> %s\n' "$(firefox_chrome_state)"
    printf 'Firefox web render -> %s\n' "$(firefox_web_state)"
    printf 'Codium flags -> %s\n' "$(print_flag_value "$CODIUM_FLAGS" "--font-render-hinting=")"
}

doctor() {
    printf 'Honey %s\n' "$VERSION"
    print_paths

    printf '\nDependencias:\n'
    if command_exists bash; then ok "bash encontrado"; else die "bash no encontrado"; fi
    if command_exists fc-cache; then ok "fc-cache encontrado"; else warn "fc-cache no encontrado"; fi
    if command_exists fc-match; then ok "fc-match encontrado"; else warn "fc-match no encontrado"; fi
    if [[ -f "$PROFILE_SOURCE" ]]; then ok "perfil fuente encontrado"; else die "perfil fuente no encontrado"; fi
    if [[ -e "$KDE_GLOBALS" ]]; then ok "kdeglobals encontrado"; else warn "kdeglobals no encontrado"; fi
    if [[ -d "$FIREFOX_CONFIG_DIR" ]]; then ok "perfiles de Firefox encontrados"; else warn "perfiles de Firefox no encontrados"; fi
    if [[ -e "$GTK3_SETTINGS" ]]; then ok "GTK3 settings encontrado"; else warn "GTK3 settings no encontrado"; fi
    if [[ -e "$GTK4_SETTINGS" ]]; then ok "GTK4 settings encontrado"; else warn "GTK4 settings no encontrado"; fi
    if command_exists codium || command_exists vscodium; then ok "VSCodium encontrado"; fi
    if [[ -f "$HONEY_ENVIRONMENT_TARGET" ]]; then ok "environment.d Honey encontrado"; else warn "environment.d Honey no encontrado"; fi
    if [[ -f "$HONEY_PLASMA_ENV_TARGET" ]]; then ok "hook Plasma Honey encontrado"; else warn "hook Plasma Honey no encontrado"; fi
    if [[ -d "$(dirname "$PROFILE_TARGET")" || -w "${XDG_CONFIG_HOME:-$HOME/.config}" ]]; then
        ok "directorio de configuracion disponible"
    else
        warn "no se puede confirmar escritura en el directorio de configuracion"
    fi
}

prepare_launch_environment() {
    export HONEY_ACTIVE="$HONEY_ACTIVE_VALUE"
    export HONEY_FONTCONFIG="$PROFILE_TARGET"
    export FREETYPE_PROPERTIES="$HONEY_FREETYPE_PROPERTIES"
    export SKIA_FONT_PREFER_SUBPIXEL=1
    export CAIRO_ANTIALIAS_DEFAULT=gray
}

resolve_codium_bin() {
    local bin=""

    if command_exists codium; then
        bin="$(command -v codium)"
    elif command_exists vscodium; then
        bin="$(command -v vscodium)"
    elif [[ -x "/usr/bin/codium" ]]; then
        bin="/usr/bin/codium"
    fi

    [[ -n "$bin" ]] || return 1
    printf '%s\n' "$bin"
}

launch_electron() {
    local cmd="${1:-}"
    if [[ -z "$cmd" ]]; then
        die "Uso: honey launch-electron <comando_o_ejecutable> [argumentos...]"
    fi
    shift || true

    local bin=""
    if command_exists "$cmd"; then
        bin="$(command -v "$cmd")"
    elif [[ -x "$cmd" ]]; then
        bin="$cmd"
    else
        die "No se encontro el comando o ejecutable: $cmd"
    fi

    prepare_launch_environment
    "$bin" "${HONEY_ELECTRON_FLAGS[@]}" "$@"
}

launch_code() {
    local bin=""
    if command_exists code; then
        bin="$(command -v code)"
    elif command_exists code-oss; then
        bin="$(command -v code-oss)"
    fi
    [[ -n "$bin" ]] || die "No encontre VS Code (code o code-oss)"

    prepare_launch_environment
    "$bin" "${HONEY_ELECTRON_FLAGS[@]}" "$@"
}

launch_cursor() {
    local bin=""
    if command_exists cursor; then
        bin="$(command -v cursor)"
    fi
    [[ -n "$bin" ]] || die "No encontre Cursor (cursor)"

    prepare_launch_environment
    "$bin" "${HONEY_ELECTRON_FLAGS[@]}" "$@"
}

launch_codium() {
    local bin

    bin="$(resolve_codium_bin || true)"
    [[ -n "$bin" ]] || die "No encontre codium"

    prepare_launch_environment
    "$bin" "${HONEY_ELECTRON_FLAGS[@]}" "$@"
}

install_system() {
    [[ $EUID -eq 0 ]] || die "El comando 'install-system' requiere privilegios de superusuario (ejecute con sudo)."

    local shim_src="$ROOT_DIR/target/release/libhoney_shim.so"

    if [[ ! -f "$shim_src" && -f "$ROOT_DIR/libhoney_shim.so" ]]; then
        shim_src="$ROOT_DIR/libhoney_shim.so"
    fi

    if [[ ! -f "$shim_src" && -n "${SUDO_USER:-}" ]]; then
        local user_home
        user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
        if [[ -f "$user_home/Proyectos/Honey/target/release/libhoney_shim.so" ]]; then
            shim_src="$user_home/Proyectos/Honey/target/release/libhoney_shim.so"
        elif [[ -f "$user_home/.local/share/honey/target/release/libhoney_shim.so" ]]; then
            shim_src="$user_home/.local/share/honey/target/release/libhoney_shim.so"
        fi
    fi

    if [[ ! -f "$shim_src" ]]; then
        printf 'Compilando Honey Rust Core en perfil release...\n'
        local cargo_cmd="cargo"
        if ! command -v cargo >/dev/null 2>&1; then
            if [[ -n "${SUDO_USER:-}" ]]; then
                local user_home
                user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
                if [[ -x "$user_home/.cargo/bin/cargo" ]]; then
                    cargo_cmd="$user_home/.cargo/bin/cargo"
                    export PATH="$user_home/.cargo/bin:$PATH"
                fi
            fi
            if [[ -x "$HOME/.cargo/bin/cargo" ]]; then
                cargo_cmd="$HOME/.cargo/bin/cargo"
                export PATH="$HOME/.cargo/bin:$PATH"
            fi
        fi
        (cd "$ROOT_DIR" && "$cargo_cmd" build --release -p honey-shim)
    fi
    [[ -f "$shim_src" ]] || die "No se encontro el binario compilado en $shim_src"

    local backup_dir="/var/backups/honey"
    mkdir -p "$backup_dir"

    if command_exists dpkg-divert; then
        local deb_lib="/usr/lib/x86_64-linux-gnu/libfreetype.so.6"
        local deb_divert="/usr/lib/x86_64-linux-gnu/libfreetype.so.6.distrib"
        local honey_target="/usr/lib/honey/libfreetype.so.6"

        mkdir -p "/usr/lib/honey"
        cp -f "$shim_src" "$honey_target"
        chmod 755 "$honey_target"

        if command -v restorecon >/dev/null 2>&1; then
            restorecon -F "$honey_target" 2>/dev/null || true
        fi
        if command -v chcon >/dev/null 2>&1; then
            chcon -t lib_t "$honey_target" 2>/dev/null || true
        fi

        if [[ ! -e "$deb_divert" && -e "$deb_lib" ]]; then
            dpkg-divert --package honey-freetype --add --rename --divert "$deb_divert" "$deb_lib"
        fi
        ln -sf "$honey_target" "$deb_lib"
        ldconfig
        ok "Sustitucion completada via dpkg-divert en $deb_lib"
    else
        local dest_dir="/usr/local/lib"
        [[ -d "/usr/local/lib64" ]] && dest_dir="/usr/local/lib64"
        mkdir -p "$dest_dir"

        cp -f "$shim_src" "$dest_dir/libhoney_shim.so"
        ln -sf libhoney_shim.so "$dest_dir/libfreetype.so.6"
        chmod 755 "$dest_dir/libhoney_shim.so"

        # Compatibilidad con SELinux en Fedora/RHEL/CentOS
        if command -v restorecon >/dev/null 2>&1; then
            restorecon -F "$dest_dir/libhoney_shim.so" "$dest_dir/libfreetype.so.6" 2>/dev/null || true
        fi
        if command -v chcon >/dev/null 2>&1; then
            chcon -t lib_t "$dest_dir/libhoney_shim.so" 2>/dev/null || true
        fi

        local conf_file="/etc/ld.so.conf.d/00-honey.conf"
        printf '%s\n' "$dest_dir" > "$conf_file"
        chmod 644 "$conf_file"

        if command -v restorecon >/dev/null 2>&1; then
            restorecon -F "$conf_file" 2>/dev/null || true
        fi

        ldconfig

        if command_exists fc-cache; then
            fc-cache -f /usr/share/fonts/google-noto-vf 2>/dev/null || fc-cache -r 2>/dev/null || true
        fi

        # Smoke test inmediato de proteccion del sistema
        local test_bin=""
        for b in /usr/bin/fc-match /usr/bin/fc-list /usr/bin/alacritty /usr/bin/codium; do
            if [[ -x "$b" ]]; then test_bin="$b"; break; fi
        done

        if [[ -n "$test_bin" ]]; then
            local resolved
            resolved="$(ldd "$test_bin" 2>/dev/null | grep libfreetype.so.6 || true)"
            ok "Prueba de enlace superada para $test_bin: $resolved"

            local exec_test
            if ! exec_test="$(fc-match "sans-serif" 2>&1)" || ! fc-list >/dev/null 2>&1; then
                warn "La prueba de ejecucion con fontconfig fallo: $exec_test"
                warn "Revirtiendo de inmediato el reemplazo para proteger el entorno grafico..."
                rm -f "$conf_file" "$dest_dir/libhoney_shim.so" "$dest_dir/libfreetype.so.6"
                ldconfig
                die "Instalacion cancelada por seguridad. Se restauro FreeType oficial."
            fi
            ok "Prueba de ejecucion en vivo superada: $exec_test"
        fi
        ok "Honey Rust Core instalado a nivel de sistema en $dest_dir/libfreetype.so.6"
    fi
}

status_system() {
    printf 'Estado del reemplazo de sistema de Honey:\n'
    local conf_file="/etc/ld.so.conf.d/00-honey.conf"
    local deb_divert="/usr/lib/x86_64-linux-gnu/libfreetype.so.6.distrib"
    local active=false

    if [[ -f "$conf_file" ]]; then
        printf '  ld.so configuracion: %s -> %s\n' "$conf_file" "$(cat "$conf_file")"
        active=true
    fi
    if [[ -f "$deb_divert" ]]; then
        printf '  dpkg-divert activo: %s\n' "$deb_divert"
        active=true
    fi

    printf '\nResolucion dinamica de ejecutables del sistema:\n'
    for b in /usr/bin/fc-match /usr/bin/alacritty /usr/bin/codium /usr/bin/code; do
        if [[ -x "$b" ]]; then
            local res
            res="$(ldd "$b" 2>/dev/null | grep libfreetype.so.6 || true)"
            printf '  %-20s: %s\n' "$(basename "$b")" "${res:-No enlaza con FreeType}"
        fi
    done

    if $active; then
        ok "Motor tipografico activo: Honey Rust Core (Paridad Quartz)"
    else
        warn "Motor tipografico activo: FreeType original de la distribucion"
    fi
}

restore_system() {
    [[ $EUID -eq 0 ]] || die "El comando 'restore-system' requiere privilegios de superusuario (ejecute con sudo)."

    local conf_file="/etc/ld.so.conf.d/00-honey.conf"
    if [[ -f "$conf_file" ]]; then
        rm -f "$conf_file"
        ok "Retirado $conf_file"
    fi

    local dest_dir="/usr/local/lib"
    [[ -d "/usr/local/lib64" ]] && dest_dir="/usr/local/lib64"
    rm -f "$dest_dir/libhoney_shim.so" "$dest_dir/libfreetype.so.6"

    if command_exists dpkg-divert; then
        local deb_lib="/usr/lib/x86_64-linux-gnu/libfreetype.so.6"
        local deb_divert="/usr/lib/x86_64-linux-gnu/libfreetype.so.6.distrib"
        if [[ -e "$deb_divert" ]]; then
            rm -f "$deb_lib"
            dpkg-divert --package honey-freetype --remove --rename --divert "$deb_divert" "$deb_lib"
            ok "Restaurado binario oficial de distribucion via dpkg-divert"
        fi
    fi

    ldconfig
    ok "Sistema restaurado al motor FreeType original de fabrica."
}

set_desktop_profile() {
    local target_profile="${1:-}"
    case "$target_profile" in
        gnome|GNOME)
            mkdir -p "$STATE_DIR"
            echo "gnome" > "$STATE_DIR/profile"
            if command_exists gsettings; then
                gsettings set org.gnome.desktop.interface font-hinting 'none' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface font-antialiasing 'grayscale' 2>/dev/null || true
                gsettings set org.gnome.desktop.interface font-rgba-order 'none' 2>/dev/null || true
            fi
            export HONEY_PROFILE="gnome"
            ok "Perfil GNOME activado: dilatacion Mutter 1.15x, hintstyle=none, escala de grises de 8 bits"
            ;;
        kde|KDE)
            mkdir -p "$STATE_DIR"
            echo "kde" > "$STATE_DIR/profile"
            export HONEY_PROFILE="kde"
            ok "Perfil KDE activado: fidelidad vectorial para Distance Fields SDF y escala geometrica 1:1"
            ;;
        *)
            die "Uso: honey profile set [gnome|kde]"
            ;;
    esac
}

status_desktop_profile() {
    local prof="standard"
    if [[ -f "$STATE_DIR/profile" ]]; then
        prof="$(cat "$STATE_DIR/profile" 2>/dev/null || echo "standard")"
    elif [[ "${XDG_CURRENT_DESKTOP:-}" == *"GNOME"* ]]; then
        prof="gnome (auto-detectado por XDG_CURRENT_DESKTOP)"
    elif [[ "${XDG_CURRENT_DESKTOP:-}" == *"KDE"* ]]; then
        prof="kde (auto-detectado por XDG_CURRENT_DESKTOP)"
    fi
    printf 'Perfil de escritorio activo: %s\n' "$prof"
    if command_exists gsettings && [[ "${XDG_CURRENT_DESKTOP:-}" == *"GNOME"* ]]; then
        printf '  GNOME font-hinting     : %s\n' "$(gsettings get org.gnome.desktop.interface font-hinting 2>/dev/null || echo 'desconocido')"
        printf '  GNOME font-antialiasing: %s\n' "$(gsettings get org.gnome.desktop.interface font-antialiasing 2>/dev/null || echo 'desconocido')"
        printf '  GNOME font-rgba-order  : %s\n' "$(gsettings get org.gnome.desktop.interface font-rgba-order 2>/dev/null || echo 'desconocido')"
    fi
}

main() {
    local command_name="${1:-help}"
    shift || true

    case "$command_name" in
        apply) apply_profile ;;
        reset) reset_profile ;;
        profile)
            case "${1:-}" in
                set) shift; set_desktop_profile "${1:-}" ;;
                status) status_desktop_profile ;;
                *) die "Uso: honey profile [set gnome|set kde|status]" ;;
            esac
            ;;
        install-system) install_system "$@" ;;
        status-system) status_system "$@" ;;
        restore-system) restore_system "$@" ;;
        launch-electron) launch_electron "$@" ;;
        launch-code) launch_code "$@" ;;
        launch-cursor) launch_cursor "$@" ;;
        launch-codium) launch_codium "$@" ;;
        status) status ;;
        doctor) doctor ;;
        paths) print_paths ;;
        version|-v|--version) printf 'Honey %s\n' "$VERSION" ;;
        help|-h|--help) usage ;;
        *)
            usage
            die "Comando desconocido: $command_name"
            ;;
    esac
}

main "$@"
